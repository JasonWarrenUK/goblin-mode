{
	"$schema": "clod-theme/core@1",
	"family": "clod",
	"version": 1,
	"rationale": {
		"mood": "Ink and brass: a slate-blue study with one warm metal accent and a cool teal second voice. Quiet, legible, unhurried.",
		"inspiration": "Fountain-pen ink on warm paper; brass instrument fittings against navy felt in a case.",
		"anchor_reason": "Brass (D9A441) reads as deliberate on both a warm paper light surface and a slate dark surface, so one accent survives both variants without a hue swap.",
		"rule_bent": "The light surface is warm paper rather than white, so 'surface-raised' is the whiter of the two; most systems do the opposite.",
		"rejected": [
			{
				"palette": "clod-terminal-default (pink → violet → teal)",
				"why": "that gradient belongs to the terminal prompt; reusing it on every artefact would make the portfolio one long screenshot of the shell"
			},
			{
				"palette": "tailwind indigo on slate",
				"why": "the default of every generated landing page; a fallback theme should still look chosen"
			}
		]
	},
	"anchor": {
		"name": "brass",
		"hex": "#D9A441",
		"oklch": [
			0.76,
			0.14,
			80
		]
	},
