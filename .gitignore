# Allowlist: ignore every root entry, then re-include the parts that make up the
# public repo. Anything Claude Code drops at the root (caches, daemon state,
# session data) is ignored without needing its own rule.
/*

# === INCLUDE ===
!/.gitignore
!/README.md
!/CLAUDE.md
!/CHANGELOG.md
!/keybindings.json
!/assets/

# My customisations
!/agents/
!/docs/
docs/personal/
docs/archive/
docs/artefacts/

!/hooks/
hooks/post-commit

!/output-styles/
!/skills/
skills/synced/
!/library/
library/references/stud.7z

# Person dossiers stay local; the schema that documents them does not
/library/profiles/dossier/*
!/library/profiles/dossier/README.md

# Personal usage data (pain points, etc.) stays local; the schema does not
/library/state/*.json
/library/state/*.jsonl
!/library/state/README.md

# Dependency trees under library/scripts/* stay local; never track node_modules or lockfiles
library/scripts/**/node_modules/
library/scripts/**/bun.lock

# The published site is tracked; its editing guidance is local only
!/site/
/site/CLAUDE.md
/site/.vercel/

# The marketplace and its manifest; generated type stubs stay local
!/marketplace/
!/.claude-plugin/
marketplace/*/.claude-plugin/types/

# === EXCLUDE INSIDE INCLUDED DIRS ===
.DS_Store
__pycache__/
.pytest_cache/
