# Ignore everything by default
!/.gitignore

# === INCLUDE ===
# Docs
!/README.md
!/CLAUDE.md
!/keybindings.json

# My customisations
!/agents/**
!/docs/**
docs/personal/

!/hooks/**
hooks/post-commit

!/output-styles/**
!/skills/**
!/library/**

# Person dossiers stay local; the schema that documents them does not
/library/profiles/dossier/*
!/library/profiles/dossier/README.md

# Personal usage data (pain points, etc.) stays local; the schema does not
/library/state/*.json
!/library/state/README.md

# The published site is tracked; its editing guidance is local only
!/site/**
/site/CLAUDE.md
/site/.vercel/

