{
	"$schema": "clod-theme/core@1",
	"family": "goblin",
	"version": 1,
	"rationale": {
		"mood": "Official paperwork as a goblin would produce it, having seen a form once: mouldy paper and bog-black ink on a stained desk, scavenged cardboard folders, one beetroot stamp, one moss stamp and a slime highlighter it found somewhere.",
		"inspiration": "The Goblin Mode Notice artifact (November 2026), whose three voices are three materials: the pedant on a typewriter, the goblin in marker and the plain instruction on printed slips.",
		"anchor_reason": "Beetroot is the stamp ink, the one mark on the page that means a ruling has been made; it clears AA on both the paper and the bog surface (7.1 and 6.9), where the slime highlighter the goblin loves fails as text on paper at 1.3.",
		"rule_bent": "Slime stays in the theme although it can never carry text in the light variant: it is a highlighter and a fill, and only ever sits behind ink (on-slime). Beyond the twelve required roles the theme carries the notice's materials (desk, slip, card, tape, exhibit) and two extra type slots, because the look is made of them.",
		"rejected": [
			{
				"palette": "Slime as the anchor",
				"why": "The most goblin colour on the page fails 4.5:1 as text on paper in every lightness that keeps it slime; as an anchor it would have forced every link into an underline-only treatment."
			},
			{
				"palette": "The skill explainers' per-family reasonable-colors hues on a neutral grey",
				"why": "One site now carries both, and the explainers are being re-dressed in the notice's materials; a neutral base would have made the goblin a guest on its own site."
			},
			{
				"palette": "Cardboard brown as the anchor",
				"why": "At 2.5:1 on paper it needs darkening to an ochre that reads as mud, and the folders already own that colour as a material."
			}
		]
	},
